// External integrations
model {
  hashicorp_vault = system 'HashiCorp Vault' {
    description 'External secret storage backend'
    style {
      shape storage
    }
  }
  
  prometheus = system 'Prometheus' {
    description 'Metrics collection and monitoring'
    style {
      shape storage
    }
  }
  
  // Integration relationships
  chronowarden.api -> hashicorp_vault 'reads/writes secrets via hvac'
  prometheus -> chronowarden.api 'scrapes /metrics endpoint'
}

views {
  view integrations {
    include chronowarden
    include chronowarden.api
    include hashicorp_vault
    include prometheus
  }
}