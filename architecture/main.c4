model {
  user = actor 'User' {
    description 'Authenticated Chronowarden user'
  }

  chronowarden = system 'Chronowarden' {
    component frontend {
      description 'Svelte-based web UI for secret management'
    }
    
    component api {
      description 'FastAPI REST backend with OpenAPI support'
    }
    
    component database {
      description 'Secret metadata storage'
      style {
        shape cylinder
      }
    }
    
    // User uses the UI
    user -> chronowarden.frontend 'opens in browser'
    
    // Frontend calls API
    chronowarden.frontend -> chronowarden.api 'REST API calls'
    
    // API stores metadata
    chronowarden.api -> chronowarden.database 'stores secret metadata'
  }
}

views {
  view index {
    include *
    include chronowarden.*
  }
}
