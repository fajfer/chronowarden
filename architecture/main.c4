model {
  user = actor 'User' {
    description 'Authenticated Chronowarden user'
  }

  pipelines = actor 'API client' {
    description 'Pipeline or script calling the API with a named API token (ADR-026)'
  }

  idp = system 'Identity provider' {
    description 'Any OIDC provider (Keycloak, Entra ID, Okta, Dex); its groups map to Chronowarden roles'
  }

  authproxy = system 'Authenticating proxy' {
    description 'Optional reverse proxy such as oauth2-proxy that logs users in and passes identity headers (auth.mode: proxy)'
  }

  backends = system 'Secret backends' {
    description 'Configured in vaults: by provider type (ADR-011); today HashiCorp Vault and OpenBao KV v2. Only per-secret metadata is read and written, never values (ADR-004)'
  }

  receivers = system 'Webhook receivers' {
    description 'Chat tools, incident tools or Alertmanager-compatible endpoints that get Chronowarden alerts'
  }

  chronowarden = system 'Chronowarden' {
    component frontend {
      technology 'SvelteKit, TypeScript, Tailwind CSS'
      description 'Dark mode dashboard UI for secret monitoring, owner and system management, assignments, and sync control'

    }

    component database {
      technology 'sqlite'
      description 'SQLite database storing the rebuildable secret metadata cache, plus owners, systems and their assignments to secrets (not rebuildable: back it up). Schema migrated at startup'

      style {
        shape cylinder
      }
    }
    
    component backend {
      technology 'Python'
      description 'Backend service for Chronowarden with metadata management and polling'
    }

    component metadata {
      technology 'Python'
      description 'Metadata management module for TTL calculation, date parsing, and sync with severity cascade resolution'
    }

    component audit {
      technology 'Python'
      description 'Append-only, hash-chained audit log of every change Chronowarden makes or sees; verifiable and exportable as JSON Lines'
    }

    component alerting {
      technology 'Python'
      description 'Webhook alerting: alert rules, state with repeat and resolve, Alertmanager-compatible payloads, Standard Webhooks signing, a delivery queue with retries and a log (ADR-025)'
    }

    component auth {
      technology 'Python, Authlib'
      description 'Authentication and permissions (ADR-015, ADR-026): OIDC login with PKCE, trusted proxy headers or hashed API tokens resolve a caller with a role (admin, owner, viewer) and the owners they act for; server-side sessions'
    }

    component compliance {
      technology 'Python, Typst'
      description 'Compliance evidence: summaries, gaps, reporting periods, policies from config evaluated per control (green/amber/red), frozen SHA-256 hashed snapshots with their policy results, and PDF/A reports of snapshots rendered with Typst'
    }

    // User uses the UI
    user -> chronowarden.frontend 'Views secret metadata, manages owners and systems, assigns secrets, triggers sync'
    user -> idp 'Logs in (auth.mode: oidc)'
    user -> authproxy 'Logs in (auth.mode: proxy)'
    authproxy -[api]-> chronowarden.backend 'Forwards requests with X-Forwarded-User/Email/Groups'
    pipelines -[api]-> chronowarden.backend 'Calls the API with Authorization: Bearer cwt_...'
    chronowarden.backend -[api]-> chronowarden.auth 'Resolves the caller of every request and checks the permission matrix'
    chronowarden.auth -[api]-> idp 'Discovery, code exchange and ID token keys'
    chronowarden.auth -[api]-> chronowarden.database 'Sessions, pending logins and API tokens, stored as hashes'
    // Frontend interacts with the database
    chronowarden.frontend -[api]-> chronowarden.backend 'Triggers API through frontend'
    // Backend interacts with the database
    chronowarden.backend -[api]-> chronowarden.database 'Stores the metadata cache, owners, systems and assignments keyed by secret identity'
    // Every change is recorded in the audit log, stored in the database
    chronowarden.backend -[api]-> chronowarden.audit 'Records changes and verifies the hash chain'
    chronowarden.audit -[api]-> chronowarden.database 'Appends events to audit_events (never updates or deletes)'
    chronowarden.backend -[api]-> chronowarden.alerting 'Evaluates alerts after syncs, confirmations and snapshots'
    chronowarden.alerting -[api]-> chronowarden.database 'Keeps alert state and the webhook delivery queue'
    chronowarden.alerting -[api]-> receivers 'POSTs signed, Alertmanager-compatible webhooks'
    chronowarden.backend -[api]-> chronowarden.compliance 'Builds summaries, gap reports, policy evaluations, snapshots and PDF reports'
    chronowarden.compliance -[api]-> chronowarden.database 'Stores snapshots in compliance_snapshots (never updated or deleted)'
    // Backend uses metadata module
    chronowarden.backend -[api]-> chronowarden.metadata 'TTL calculation and sync'
    chronowarden.metadata -[api]-> backends 'Lists secrets, reads metadata and merges chronowarden_* keys through the provider registry'

  }
}

views {
  view index {
    include *
    include chronowarden.*
  }
}
