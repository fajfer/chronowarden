model {
  user = actor 'User' {
    description 'Authenticated Chronowarden user'
  }

  chronowarden = system 'Chronowarden' {
    component frontend {
      technology 'JavaScript'
      description 'Web-based user interface for Chronowarden'

    }

    component database {
      technology 'sqlite'
      description 'SQLite database storing secret metadata cache and engine configuration'

      style {
        shape cylinder
      }
    }
    
    component backend {
      technology 'Python'
      description 'Backend service for Chronowarden with metadata management and polling'
    }

    component metadata {
      technology 'Python'
      description 'Metadata management module for TTL calculation, date parsing, and sync'
    }

    // User uses the UI
    user -> chronowarden.frontend 'CRUD operations on secrets'
    // Frontend interacts with the database
    chronowarden.frontend -[api]-> chronowarden.backend 'Triggers API through frontend'
    // Backend interacts with the database
    chronowarden.backend -[api]-> chronowarden.database 'Stores and retrieves secret metadata cache'
    // Backend uses metadata module
    chronowarden.backend -[api]-> chronowarden.metadata 'TTL calculation and sync'

  }
}

views {
  view index {
    include *
    include chronowarden.*
  }
}
